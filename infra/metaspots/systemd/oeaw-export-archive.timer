[Unit]
Description=Archive raw OeAW exports at 06:15 Europe/Vienna (before the 06:30 ingest)
Documentation=https://github.com/mleihs/oeaw-press-relevance

[Timer]
OnCalendar=*-*-* 06:15:00 Europe/Vienna
# Persistent wie beim Ingest-Timer: war die Box um 06:15 down, laeuft das
# Archiv beim Boot nach. Ohne Catch-up fehlt fuer genau diese Nacht der
# Rohexport-Beleg — die Exporte werden um ~03:00 ueberschrieben, und der
# Ingest (Persistent=true) wuerde ein UNarchiviertes Delta anwenden. Ein
# Nachlauf spaeter am Tag holt dieselbe Datei; doppelt laufen ist harmlos
# (Stempel kommt aus meta.generated_at des Feeds, und eine bereits
# existierende Stempel-Datei wird nie ueberschrieben).
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
